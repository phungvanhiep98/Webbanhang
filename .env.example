# Địa chỉ web (dùng cho link trả về từ cổng thanh toán)
SITE_URL=http://localhost:3000
SHOP_NAME=Shop Như Ý Bé

# Mật khẩu vào trang quản lý /admin
# Postgres (Vercel + Neon tự điền). Để trống = lưu vào file SQLite data/shop.db
DATABASE_URL=

ADMIN_PASSWORD=doi-mat-khau-nay

# Chuyển khoản qua mã VietQR (mã ngân hàng theo https://api.vietqr.io/v2/banks, vd: VCB, MB, TCB, ACB)
BANK_ID=MB
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A

# Tự xác nhận chuyển khoản qua SePay (my.sepay.vn → Webhook, xác thực API Key)
SEPAY_API_KEY=

# Báo đơn mới qua Telegram: tạo bot với @BotFather, dán token vào đây,
# rồi vào /admin → Thông báo → Kết nối Telegram.
TELEGRAM_BOT_TOKEN=

# (Tùy chọn, để trống = ẩn) VNPay (sandbox: https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# (Tùy chọn, để trống = ẩn) MoMo (sandbox: https://developers.momo.vn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
